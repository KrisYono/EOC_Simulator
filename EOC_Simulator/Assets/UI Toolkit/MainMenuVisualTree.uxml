<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=484b49d2ea9c94002a8f17395659b1fe&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="MainMenu" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI%20Assets/MainMenuBGImage.png?fileID=2800000&amp;guid=ba7f2568722e64c2ba4f63c01d84299c&amp;type=3#MainMenuBGImage&quot;); -unity-background-scale-mode: stretch-to-fill; background-size: 100% 100%; text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(140, 130, 130); display: flex;">
        <engine:Label text="Welcome to Emergency&#10;Operations Centre (EOC) Simulator" name="Title" parse-escape-sequences="false" class="header" style="font-size: 60px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=40c3079bd7b634103b3dd876b49e9d56&amp;type=3#NotInter-Regular&quot;); -unity-font-style: bold; -unity-text-align: upper-center; align-content: flex-start; translate: 0 200px; text-shadow: 5px 100px 10px rgba(0, 0, 0, 0); letter-spacing: 0;" />
        <engine:Button text="Let&apos;s Begin" name="StartButton" class="button" style="width: 200px; height: 50px; font-size: 30px; -unity-font-style: bold; background-color: rgb(86, 127, 209); transform-origin: center; translate: 850px 600px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; -unity-background-image-tint-color: rgb(221, 66, 66);" />
        <engine:Label text="Master crisis management with our immersive Emergency Operations&#10; Center simulator—train, strategize, and lead under pressure." name="Title" parse-escape-sequences="false" enable-rich-text="false" class="header" style="font-size: 30px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=40c3079bd7b634103b3dd876b49e9d56&amp;type=3#NotInter-Regular&quot;); -unity-font-style: normal; -unity-text-align: upper-center; align-content: flex-start; translate: 0 300px; text-shadow: 5px 100px 10px rgba(0, 0, 0, 0); letter-spacing: 0;" />
    </engine:VisualElement>
    <engine:VisualElement name="ChoosingCharacter" enabled="true" style="flex-grow: 1; display: none; visibility: visible; background-image: url(&quot;project://database/Assets/UI%20Assets/MainMenuBGImage.png?fileID=2800000&amp;guid=ba7f2568722e64c2ba4f63c01d84299c&amp;type=3#MainMenuBGImage&quot;); -unity-background-image-tint-color: rgb(38, 30, 30);">
        <engine:Label text="Choose Your Position" name="Title" parse-escape-sequences="false" class="header" style="font-size: 40px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=40c3079bd7b634103b3dd876b49e9d56&amp;type=3#NotInter-Regular&quot;); -unity-font-style: bold; -unity-text-align: upper-center; align-content: flex-start; translate: -600px 50px; text-shadow: 5px 100px 10px rgba(0, 0, 0, 0); letter-spacing: 0; transform-origin: left top;" />
        <engine:Button name="EOC_Director" style="background-size: 100% 100%; scale: 2 2; translate: 80px 140px; -unity-background-scale-mode: stretch-to-fill; transform-origin: center; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-image: url(&quot;project://database/Assets/UI%20Assets/MainMenuBGImage.png?fileID=2800000&amp;guid=ba7f2568722e64c2ba4f63c01d84299c&amp;type=3#MainMenuBGImage&quot;); border-left-color: rgba(53, 20, 20, 0); border-right-color: rgba(53, 20, 20, 0); border-top-color: rgba(53, 20, 20, 0); border-bottom-color: rgba(53, 20, 20, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; display: flex; width: 100px; height: 100px;" />
        <engine:Button text="Back to Main Menu" name="BackToMainMenu" style="translate: 93px 750px; scale: 1 1; width: 150px;" />
        <engine:Button text="Next" name="Next" style="translate: 1400px 700px; scale: 1 1; width: 150px;" />
        <engine:VisualElement name="PositionInformation_EOCDirector" style="flex-grow: 1; background-color: rgba(144, 99, 99, 0); background-image: url(&quot;project://database/Assets/UI%20Assets/MainMenuBGImage.png?fileID=2800000&amp;guid=ba7f2568722e64c2ba4f63c01d84299c&amp;type=3#MainMenuBGImage&quot;); -unity-background-image-tint-color: rgb(31, 120, 46); background-size: 50% 100%; translate: 456px -216px; display: none;" />
    </engine:VisualElement>
</engine:UXML>
